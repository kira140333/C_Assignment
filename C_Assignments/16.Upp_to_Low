#include <stdio.h>
#include <string.h>

int main() {
    char str[200];
    int i;
    
    printf("Enter a string: ");
    scanf(" %[^\n]", str);
    
    // Loop through each character
    for(i=0;i<strlen(str); i++) {
        
        // Check if character is uppercase (between 'A' and 'Z')
        if(str[i] >= 'A' && str[i] <= 'Z') {
            /* Convert to lowercase using ASCII
            'A' = 65, 'a' = 97 -> difference 32
            'B' = 66, 'b' = 98 -> difference 32
            Adding 32 to any uppercase gives its lowercase version
            */
            str[i]=str[i]+32;
        }
        
    }
    
    printf("Lowercase string: %s\n", str);
    
    return 0;
}
