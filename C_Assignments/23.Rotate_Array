#include <stdio.h>

int main() {
    int n,i,pos;
    char dir;
    
    printf("Enter size: ");
    scanf("%d", &n);
    
    int arr[n],temp[n];
    
    for(i=0;i<n;i++) {
        printf("Enter element %d: ",i+1);
        scanf("%d",&arr[i]);
        
    }
    
    printf("Enter positions to rotate: ");
    scanf("%d",&pos);
    
    printf("Direction (l/r): ");
    scanf(" %c",&dir);
    
    pos=pos%n;
    
    for(i=0;i<n;i++) {
        if(dir=='l')
        temp[(i-pos+n)%n]=arr[i];
        else
        temp[(i+pos)%n]=arr[i];
    }
    
    printf("Rotated array: ");
    for(i=0;i<n;i++)
    printf("%d ",temp[i]);
    printf("\n");
    
    return 0;
}
