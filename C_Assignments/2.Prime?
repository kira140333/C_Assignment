#include <stdio.h>
int main() {
int number;
int isprime = 1; // 1 means TRUE. Assuming it is prime at the start.

printf("Enter an integer: ");
scanf("%d", &number);

if(number<2){
isprime=0; // 0 means FALSE
}else{
for(int i=2;i<=number/2;i++){
if(number%i==0){
isprime=0;
break;
}
}
}
if(isprime==1){
printf("%d is a prime number.\n", number);
}else {
printf("%d is not a prime number.\n", number);
}
return 0;
}
