#include <stdio.h>

int main() {
    int size;
    
    printf("Enter size of array: ");
    scanf("%d", &size);
    
    int arr[size],temp[size];
    
    printf("Enter elements:\n");
    for(int i=0;i<size;i++)
    scanf("%d", &arr[i]);
    
    int k=0;
    
    for(int i=0;i<size;i++)
    if(arr[i]<0)
    temp[k++]=arr[i];
    
    for(int i=0;i<size;i++)
    if(arr[i]>=0)
    temp[k++]=arr[i];
    
    printf("Rearranged array:\n");
    for(int i=0;i<size;i++)
    printf("%d ",temp[i]);
    printf("\n");
    
    return 0;
}
