#include <stdio.h>

int main() {
    int num,pos,n;
    
    printf("Enter number: ");
    scanf("%d", &num);
    
    printf("Enter starting bit position: ");
    scanf("%d", &pos);
    
    printf("Enter number of bits to toggle: ");
    scanf("%d", &n);
    
    for(int i=0;i<n;i++) {
        num=num^(1<<(pos+i));
    }
    
    printf("Result: %d\n", num);
    
    return 0;
}
