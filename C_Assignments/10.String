#include <stdio.h>
#include <string.h>

int main() {
    char numStr[100];
    int result = 0;
    
    printf("Enter a number as a string: ");
    scanf("%s", numStr);
    
    for(int i=0; i<strlen(numStr); i++) {
        result = result * 10 + (numStr[i] - '0');
    }
    
    printf("Integer value: %d\n", result);
    
    return 0;
}
