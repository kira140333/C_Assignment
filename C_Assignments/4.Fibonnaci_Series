#include <stdio.h>

int main() {
    int n;
    printf("Enter the number of terms: ");
    scanf("%d", &n);
    
    if(n<=0) {
        printf("Error: Number of terms must be a positive integer.\n");
        return 1;
    }
    
    long long a=0,b=1,next;
    
    printf("Fibonnaci Series: ");
    
    for(int i=1;i<=n;i++) {
        printf("%lld", a);
        
        if(i<n) printf(", ");
        
        next = a+b;
        a=b;
        b=next;
        
    }
    printf("\n");
    
    return 0;
}
