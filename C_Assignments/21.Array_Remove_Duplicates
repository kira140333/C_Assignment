#include <stdio.h>

int main() {
    int n,i,j,k;
    
    printf("Enter size: ");
    scanf("%d", &n);
    
    int arr[n];
    
    for(i=0;i<n;i++) {
        printf("Enter element %d: ",i+1);
        scanf("%d", &arr[i]);
    }
    
    for(i=0;i<n;i++) {
        for(j=i+1;j<n;j++) {
            if(arr[i]==arr[j]) {
                for(k=j;k<n-1;k++) {
                    arr[k]=arr[k+1];
                }
                n--;
                j--;
            }
        }
    }
    
    printf("Array after removing duplicates: ");
    for(i=0;i<n;i++) {
        printf("%d ",arr[i]);
    }
    printf("\n");
    
    return 0;
}
