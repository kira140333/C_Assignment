#include <stdio.h>

int main() {
    int n, i;
    
    printf("Enter size: ");
    scanf("%d", &n);
    
    int arr[n];
    
    for(i=0;i<n;i++) {
        printf("Enter element %d: ",i+1);
        scanf("%d", &arr[i]);
    }
    
    int max1=arr[0], max2=arr[0];
    int min1=arr[0], min2=arr[0];
    
    for(i=1;i<n;i++) {
        if(arr[i]>max1) {
            max2=max1;
            max1=arr[i];
        } else if(arr[i]>max2&&arr[i]!=max1)
        max2=arr[i];
        
        if(arr[i]<min1) {
            min2=min1;
            min1=arr[i];
        } else if(arr[i]<min2&&arr[i]!=min1)
            min2=arr[i];
    }
    
    if(max2==max1)
    printf("No second largest\n");
    else
    printf("Second largest: %d\n", max2);
    
    if(min2==min1)
    printf("No second smallest\n");
    else
    printf("Second smallest: %d\n", min2);
    
    return 0;
}
