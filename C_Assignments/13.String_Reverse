#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int left, right;
    char temp;
    
    printf("Enter a string: ");
    scanf("%s", str);
    
    // Set left pointer at start, right pointer at end
    left = 0;
    right = strlen(str) - 1;
    
    // Swap characters from both ends moving inward
    while (left<right) {
        temp = str[left];
        str[left] = str[right];
        str[right] = temp;
        left++;
        right--;
    }
    
    printf("Reversed String: %s\n", str);
    
    return 0;
    
}
