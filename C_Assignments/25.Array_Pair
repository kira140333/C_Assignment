#include <stdio.h>

int main() {
    int size,target;
    
    printf("Enter size of array: ");
    scanf("%d", &size);
    
    int arr[size];
    
    printf("Enter elements:\n");
    for(int i=0;i<size;i++)
    scanf("%d", &arr[i]);
    
    printf("Enter target sum: ");
    scanf("%d", &target);
    
    int found=0;
    
    for(int i=0;i<size;i++) {
        for(int j=i+1;j<size;j++) {
            if(arr[i]+arr[j]==target) {
                printf("(%d, %d)\n",arr[i],arr[j]);
                found=1;
            }
        }
    }
    
    if(!found)
    printf("No pairs found.\n");
    
    return 0;
}
