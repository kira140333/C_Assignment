#include <stdio.h>

void countDigits(int num, int freq[]) {
    while(num>0) {
        freq[num%10]++;
        num=num/10;
    }
}

int main() {
    int num;
    int freq[10]={0};
    
    printf("Enter a positive integer: ");
    scanf("%d", &num);
    
    countDigits(num, freq);
    
    for(int i=0;i<=9;i++) {
        if(freq[i]>0)
        printf("Digit %d -> %d time(s)\n",i,freq[i]);
    }
    
    return 0;
}
