#include <stdio.h>

int secondLargest(int arr[], int size)  {
    int largest = arr[0], second = arr[1];
    
    if(second > largest)  {
        int temp = largest;
        largest = second;
        second = temp;
    }
    
    for (int i=2; i < size; i++)  {
        if(arr[i] > largest)  {
            second = largest;
            largest = arr[i];
        } else if (arr[i] > second && arr[i] != largest)  {
            second = arr[i];
        }
    }
    
    return second;
}

int main()  {
    int size, arr[100];
    
    printf("Enter size: ");
    scanf("%d", &size);
    
    printf("Enter %d numbers: ", size);
    for (int i=0; i<size; i++)
    scanf("%d", &arr[i]);
    
    printf("Second largest: %d\n", secondLargest(arr, size));
    
    return 0;
}
